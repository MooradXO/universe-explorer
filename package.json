{
  "name": "universe-explorer",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "build": "node scripts/check-space-only.mjs && tsc && vite build",
    "preview": "node --use-system-ca node_modules/vite/bin/vite.js preview",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "check:space": "node scripts/check-space-only.mjs",
    "catalog:download": "node --use-system-ca scripts/catalog/download-athyg.mjs",
    "catalog:import": "node scripts/catalog/import-athyg.mjs",
    "catalog:verify": "node scripts/catalog/verify-athyg.mjs",
    "catalog:map": "node scripts/catalog/export-map.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cannon-es": "^0.20.0",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "socket.io-client": "^4.7.4",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/howler": "^2.2.7",
    "@types/three": "^0.160.0",
    "@xmldom/xmldom": "0.9.12",
    "typescript": "^5.2.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  }
}
