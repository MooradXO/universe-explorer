# TEMPLATE ONLY. Add inside the existing game's HTTPS server block, after approval.
# Keep catalogue routes, TLS settings and all other virtual hosts unchanged.
location = /multiplayer/metrics { return 404; }
location /multiplayer/ {
    # Reconnect URLs contain session credentials; do not put them in access logs.
    access_log off;
    proxy_pass http://127.0.0.1:2567/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    client_max_body_size 16k;
}
