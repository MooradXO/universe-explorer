VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=<token>

# Colyseus: empty = local/offline flight. Explicit URL = authoritative multiplayer.
# Separate local rehearsal: ws://127.0.0.1:2567
# Production build example: wss://universe.projectai.biz/multiplayer
VITE_MULTIPLAYER_URL=
# Retained old transport for rollback only; never used when Colyseus URL is set.
VITE_LEGACY_REALTIME=false

# Optional: set only to a stream you are authorized to embed.
VITE_AMBIENT_STREAM_URL=
